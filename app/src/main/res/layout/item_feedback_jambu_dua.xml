<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_feedback"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/sym_def_app_icon"
            android:background="@drawable/bg_circle_placeholder" /> <TextView
        android:id="@+id/tvNamaUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/imgProfile"
        android:layout_marginStart="12dp"
        android:text="Nama User"
        android:textColor="@color/text_dark"
        android:textSize="15sp"
        android:textStyle="normal" />

        <LinearLayout
            android:id="@+id/layoutStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgProfile"
            android:layout_below="@id/tvNamaUser"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/star1" android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/star_on" app:tint="#FFC107" />
            <ImageView android:id="@+id/star2" android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/star_on" app:tint="#FFC107" />
            <ImageView android:id="@+id/star3" android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/star_on" app:tint="#FFC107" />
            <ImageView android:id="@+id/star4" android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/star_on" app:tint="#FFC107" />
            <ImageView android:id="@+id/star5" android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/star_on" app:tint="#FFC107" /> <TextView
            android:id="@+id/tvWaktu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="2 mins ago"
            android:textColor="#757575"
            android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/text_dark"/>

    </RelativeLayout>

    <TextView
        android:id="@+id/tvKomentar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Isi komentar feedback disini..."
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

</LinearLayout>