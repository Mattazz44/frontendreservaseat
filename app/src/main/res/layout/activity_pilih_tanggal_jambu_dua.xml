<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:fillViewport="true"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgHeader"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:scaleType="centerCrop"
                android:src="@drawable/sampul_jambu_dua" /> <View
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="#66000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <ImageView
                    android:id="@+id/btnBackHeader"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/sebelumnya"
                    app:tint="@android:color/white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reserve a Seat"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/imgHeader"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="40dp"
                android:text=" The Kirk Cafe Jambu Dua"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/imgHeader"
                android:layout_marginTop="-24dp"
                android:background="@drawable/bg_rounded_top_white"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih Tanggal dan Waktu"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tanggal :"
                        android:textSize="14sp"
                        android:layout_centerVertical="true"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_button"
                            android:text="September  ▼"
                            android:textColor="@android:color/white"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:textSize="14sp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_button"
                            android:text="2026"
                            android:textColor="@android:color/white"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </RelativeLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:id="@+id/dateContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout android:id="@+id/date23" android:tag="date" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/bg_date_unselected" android:gravity="center" android:orientation="vertical" android:layout_marginEnd="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="23" android:textSize="16sp" android:textStyle="bold" android:textColor="#000000"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MO" android:textSize="10sp" android:textColor="#555555"/>
                        </LinearLayout>

                        <LinearLayout android:id="@+id/date24" android:tag="date" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/bg_date_unselected" android:gravity="center" android:orientation="vertical" android:layout_marginEnd="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24" android:textSize="16sp" android:textStyle="bold" android:textColor="#000000"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TU" android:textSize="10sp" android:textColor="#555555"/>
                        </LinearLayout>

                        <LinearLayout android:id="@+id/date25" android:tag="date" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/bg_date_unselected" android:gravity="center" android:orientation="vertical" android:layout_marginEnd="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25" android:textSize="16sp" android:textStyle="bold" android:textColor="#000000"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WE" android:textSize="10sp" android:textColor="#555555"/>
                        </LinearLayout>

                        <LinearLayout android:id="@+id/date26" android:tag="date" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/bg_date_unselected" android:gravity="center" android:orientation="vertical" android:layout_marginEnd="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="26" android:textSize="16sp" android:textStyle="bold" android:textColor="#000000"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TH" android:textSize="10sp" android:textColor="#555555"/>
                        </LinearLayout>

                        <LinearLayout android:id="@+id/date27" android:tag="date" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/bg_date_unselected" android:gravity="center" android:orientation="vertical" android:layout_marginEnd="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="27" android:textSize="16sp" android:textStyle="bold" android:textColor="#000000"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FR" android:textSize="10sp" android:textColor="#555555"/>
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waktu :"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="32dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="5" android:layout_marginBottom="12dp">
                        <TextView android:id="@+id/time1" android:tag="time" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_time_unselected" android:gravity="center" android:text="11.00" android:textColor="#000000" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/time2" android:tag="time" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_time_unselected" android:gravity="center" android:text="12.00" android:textColor="#000000" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/time3" android:tag="time" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_time_unselected" android:gravity="center" android:text="13.00" android:textColor="#000000" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/time4" android:tag="time" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_time_unselected" android:gravity="center" android:text="14.00" android:textColor="#000000" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/time5" android:tag="time" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:background="@drawable/bg_time_unselected" android:gravity="center" android:text="15.00" android:textColor="#000000" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="5">
                        <TextView android:id="@+id/time6" android:tag="time" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_time_unselected" android:gravity="center" android:text="16.00" android:textColor="#000000" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/time7" android:tag="time" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_time_unselected" android:gravity="center" android:text="17.00" android:textColor="#000000" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/time8" android:tag="time" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_time_unselected" android:gravity="center" android:text="18.00" android:textColor="#000000" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/time9" android:tag="time" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_time_unselected" android:gravity="center" android:text="19.00" android:textColor="#000000" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/time10" android:tag="time" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:background="@drawable/bg_time_unselected" android:gravity="center" android:text="20.00" android:textColor="#000000" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="24dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnKembali"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button"
                        android:backgroundTint="@null"
                        android:text="kembali"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnLanjutkan"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button"
                        android:backgroundTint="@null"
                        android:text="Lanjutkan"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textStyle="bold" />

                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:background="@color/colorPrimary"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:src="@drawable/home" app:tint="@android:color/white"/>
        <ImageView android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:src="@drawable/recipt" app:tint="@android:color/white"/>
        <ImageView android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:src="@drawable/profile_bar" app:tint="@android:color/white"/>
    </LinearLayout>

</RelativeLayout>